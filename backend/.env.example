# CafeMind Backend Environment Configuration
# Google Gemini API key (Server-side only)
GEMINI_API_KEY=

# Database configuration: Google Cloud SQL PostgreSQL or local SQLite fallback
# Google Cloud SQL format: postgresql+psycopg2://user:password@<cloud_sql_ip_or_domain>:5432/cafemind
# Local fallback: sqlite:///./cafemind.db
DATABASE_URL=sqlite:///./cafemind.db

# App settings
ENVIRONMENT=development
PORT=8000
